def init_db(conn, block="Sample Block"):
    conn.executescript(SCHEMA)
    if conn.execute("SELECT COUNT(*) FROM opportunities").fetchone()[0] == 0:
        for row in SEED:
            cur = conn.execute("INSERT INTO opportunities(name,category,min_edu,skills,startup_cost,"
                               "income_min,income_max,needs_smartphone,hours_needed,training,funding)"
                               " VALUES(?,?,?,?,?,?,?,?,?,?,?)", row)
            conn.execute("INSERT INTO local_demand VALUES(?,?,?)",
                         (cur.lastrowid, block, DEMAND[row[0]]))
        conn.commit()
 
def score(profile, opp, demand):
    """Weighted score out of 100. Fully explainable."""
    if profile["edu"] < opp["min_edu"]:
        return None, []
    if opp["needs_smartphone"] and not profile["smartphone"]:
        return None, []
    why = []
    need = set(opp["skills"].split(","))
    have = set(profile["skills"])
    overlap = len(need & have) / len(need)
    s_skill = 40 * overlap
    if overlap:
        why.append(f"aapki skills match ({', '.join(sorted(need & have))})")
    else:
        why.append("naya skill seekhna padega (training available)")
 
    if opp["startup_cost"] <= profile["budget"]:
        s_budget = 25
        why.append("budget ke andar")
    else:
        s_budget = 25 * max(0, 1 - (opp["startup_cost"] - profile["budget"]) / opp["startup_cost"])
        why.append("loan/subsidy ki zaroorat padegi")
 
    s_demand = 20 * demand / 5
    if demand >= 4:
        why.append("aapke block mein demand high hai")
 
    s_time = 10 if profile["hours"] >= opp["hours_needed"] else 10 * profile["hours"] / opp["hours_needed"]
    s_bonus = 5 if opp["startup_cost"] <= 50000 else 0
    return round(s_skill + s_budget + s_demand + s_time + s_bonus, 1), why
 
def recommend(conn, profile, top_n=3):
    conn.row_factory = sqlite3.Row
    rows = conn.execute("""SELECT o.*, d.demand FROM opportunities o
                           JOIN local_demand d ON d.opportunity_id = o.id""").fetchall()
    results = []
    for r in rows:
        sc, why = score(profile, r, r["demand"])
        if sc is not None:
            results.append((sc, why, r))
    results.sort(key=lambda x: x[0], reverse=True)
    return results[:top_n]
 
def save_profile(conn, name, block, profile):
    cur = conn.execute("INSERT INTO youth_profiles(name,block,edu,skills,budget,hours,smartphone)"
                       " VALUES(?,?,?,?,?,?,?)",
                       (name, block, profile["edu"], ",".join(profile["skills"]),
                        profile["budget"], profile["hours"], int(profile["smartphone"])))
    conn.commit()
    return cur.lastrowid
 
def show(results):
    if not results:
        print("\nIs profile ke liye abhi koi match nahi mila. Skills ya budget badal kar try karein.")
        return
    print("\n===== Aapke liye Top opportunities =====")
    for i, (sc, why, r) in enumerate(results, 1):
        print(f"\n{i}. {r['name']}  [{r['category']}]  - Score: {sc}/100")
        print(f"   Kamai (mahine): Rs {r['income_min']:,} - Rs {r['income_max']:,}")
        print(f"   Shuruaati kharch: Rs {r['startup_cost']:,}")
        print(f"   Training: {r['training']}")
        print(f"   Funding: {r['funding']}")
        print(f"   Kyun: {'; '.join(why)}")
 
def ask_profile():
    name = input("Naam: ").strip()
    block = input("Gaon / Block: ").strip()
    edu = EDU.get(input("Padhai (8th/10th/12th/graduate): ").strip().lower(), 2)
    all_skills = sorted({s for row in SEED for s in row[3].split(",")})
    print("Skills list:", ", ".join(all_skills))
    skills = [s.strip().lower() for s in input("Aapki skills (comma se alag): ").split(",") if s.strip()]
    try:
        budget = int(input("Kitna paisa laga sakte hain (Rs): "))
        hours = int(input("Roz kitne ghante de sakte hain: "))
    except ValueError:
        print("Number daalein."); sys.exit(1)
    phone = input("Smartphone hai? (y/n): ").strip().lower() == "y"
    return name, block, {"edu": edu, "skills": skills, "budget": budget, "hours": hours, "smartphone": phone}
 
def main():
    conn = sqlite3.connect(DB)
    init_db(conn)
    if "--demo" in sys.argv:
        name, block = "Demo Youth", "Sample Block"
        profile = {"edu": 3, "skills": ["computer", "typing", "english"], "budget": 20000,
                   "hours": 4, "smartphone": True}
        print(f"Demo profile: 12th pass, skills={profile['skills']}, budget=Rs 20,000, 4 hrs/day")
    else:
        name, block, profile = ask_profile()
    save_profile(conn, name, block, profile)
    show(recommend(conn, profile))
    conn.close()
 
if __name__ == "__main__":
    main()